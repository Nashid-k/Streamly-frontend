# Browser-build values only. NEXT_PUBLIC_ values are embedded in client JS.
# Use the publicly reachable HTTPS API URL when deploying.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Never put TMDB credentials or any other secret in this file.
# Optional; only for media that your organization is licensed to provide.
# NEXT_PUBLIC_LICENSED_PLAYBACK_ORIGIN=https://media.example.com
